{
  "name": "pibu-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-token-map.mjs && node scripts/check-components.mjs && node scripts/check-tokens.mjs && node scripts/rename-brand.mjs --check",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "lint:tokens": "node scripts/check-tokens.mjs",
    "gate": "npm run lint && npm run typecheck && npm test && npm run check:boundaries && npm run check:tokens && npm run build"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@anthropic-ai/sdk": "1.3.0",
    "@aztec/bb.js": "5.0.0-nightly.20260324",
    "@noir-lang/noir_js": "1.0.0-beta.20",
    "@react-three/fiber": "^9.8.2",
    "geist": "^1.8.2",
    "jose": "6.2.13",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.6.1",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
